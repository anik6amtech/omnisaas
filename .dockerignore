# Keep the build context lean & correct (prod image builds its own vendor/assets)
.git
.gitignore
.github
/vendor
/node_modules
/public/build
/public/hot
/public/storage
/storage/logs/*
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
/database/*.sqlite
/database/*.sqlite-journal
/frankenphp
frankenphp-worker.php
.env
.env.*
!.env.example
.phpunit.cache
.phpunit.result.cache
.DS_Store
docker-compose*.yml
Dockerfile
Makefile
README.md
/docs
