# ===========================================================================
# OmniReply — environment template
# Copy to .env (`cp .env.example .env`) then `php artisan key:generate`.
# NEVER commit real secrets. Master secrets (APP_KEY, DB creds) live in .env
# only; panel-editable operational secrets are encrypted at rest in the DB.
#
# Hosts default to 127.0.0.1 for the HOST dev model (`composer dev` + Docker
# datastores). The full-Docker profile (`docker compose --profile full up`)
# overrides DB/Redis/etc. to service names via the compose env block, so this
# file does not need editing for that mode.
# ===========================================================================

APP_NAME=OmniReply
APP_ENV=local
APP_KEY=base64:sHo/kwS/CRYlnD5CdEyZKWivIPQreptHovt0p/KU0oo=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# --- Logging -----------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (PostgreSQL + pgvector) — host port 5434 (see docker-compose) --
DB_CONNECTION=pgsql
DB_HOST=postgres.aichatbot.orb.local
DB_PORT=5434
DB_DATABASE=omnireply
DB_USERNAME=omnireply
DB_PASSWORD=secret

# --- Redis (cache, queues, locks, rate-limit state, Reverb pub/sub) ----------
REDIS_CLIENT=phpredis
REDIS_HOST=redis.aichatbot.orb.local
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Session / Cache / Queue all on Redis -----------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
CACHE_PREFIX=omnireply_cache

QUEUE_CONNECTION=redis
HORIZON_PREFIX=omnireply_horizon:

# --- Broadcasting / Realtime (Laravel Reverb) -------------------------------
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=omnireply
REVERB_APP_KEY=local-reverb-key
REVERB_APP_SECRET=local-reverb-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Frontend (Vite) — public Reverb endpoint as seen by the browser
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# --- App server --------------------------------------------------------------
# Development serves via `php artisan serve` / `composer dev` (NOT Octane).
# Octane + FrankenPHP is the PRODUCTION app server (Dockerfile prod target).
OCTANE_SERVER=frankenphp

# --- Mail (Mailpit in local dev) — host ports 1025/8025 ---------------------
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@omnireply.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- Object storage (S3-compatible; MinIO locally on 9000/9001) -------------
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=omnireply
AWS_SECRET_ACCESS_KEY=secret1234
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=omnireply-media
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_URL=http://127.0.0.1:9000/omnireply-media
AWS_USE_PATH_STYLE_ENDPOINT=true

# ===========================================================================
# AI — OpenRouter via Prism (config only this phase; no pipeline logic yet)
# Lock the embedding dimension to kb_chunks.embedding (1536) — one-way door.
# ===========================================================================
PRISM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_ALLOW_FALLBACKS=true
# Cheap/fast model for intent classification:
AI_INTENT_MODEL=openai/gpt-4o-mini
# Stronger model for reply composition:
AI_GENERATION_MODEL=anthropic/claude-3.5-sonnet
# Embeddings model + locked vector dimension:
AI_EMBEDDING_MODEL=openai/text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536

# ===========================================================================
# Payments — SSLCommerz (config scaffolding only this phase)
# Two distinct integrations share the gateway: tenant SUBSCRIPTION billing
# (operator gets paid) and buyer ORDER payments (seller gets paid). IPN is the
# source of truth; never trust browser return URLs alone.
# ===========================================================================
SSLCOMMERZ_SANDBOX=true
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX_URL=https://sandbox.sslcommerz.com
SSLCOMMERZ_LIVE_URL=https://securepay.sslcommerz.com

# ===========================================================================
# Meta / Channels (placeholders — wired in E2; tokens encrypted at rest in DB)
# ===========================================================================
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
